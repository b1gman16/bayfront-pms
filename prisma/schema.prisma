generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  CASHIER
}
enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  MAINTENANCE
  OUT_OF_ORDER
}
enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}
enum PaymentKind {
  PAYMENT
  REFUND
}
enum TaskStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  DONE
}
enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum FeeType {
  PERCENT
  FIXED
}
enum FeeKind {
  TAX
  FEE
  DISCOUNT
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
}

model Guest {
  id String @id @default(cuid())
  fullName String
  phone String?
  email String?
  address String?
  nationality String?
  idType String?
  idNumberEnc String?
  notes String?
  reservations Reservation[]
  createdAt DateTime @default(now())
  @@index([fullName])
  @@index([phone])
  @@index([email])
}

model RoomType {
  id String @id @default(cuid())
  name String @unique
  baseRate Int
  maxOccupancy Int
  description String?
  active Boolean @default(true)
  rooms Room[]
  reservations Reservation[]
}

model Room {
  id String @id @default(cuid())
  number String @unique
  roomTypeId String
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  floor String?
  maxOccupancy Int
  status RoomStatus @default(AVAILABLE)
  amenities String[]
  notes String?
  reservations Reservation[]
  tasks HousekeepingTask[]
  tickets MaintenanceTicket[]
}

model Reservation {
  id String @id @default(cuid())
  code String @unique
  guestId String
  guest Guest @relation(fields: [guestId], references: [id])
  roomTypeId String
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  roomId String?
  room Room? @relation(fields: [roomId], references: [id])
  checkIn DateTime @db.Date
  checkOut DateTime @db.Date
  adults Int @default(1)
  children Int @default(0)
  status ReservationStatus @default(PENDING)
  source String @default("WALK_IN")
  ratePerNight Int
  specialRequests String?
  internalNotes String?
  version Int @default(1)
  createdById String
  cancelReason String?
  checkedInAt DateTime?
  checkedOutAt DateTime?
  checkedOutById String?
  createdAt DateTime @default(now())
  folio Folio?
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([guestId])
}

model Folio {
  id String @id @default(cuid())
  reservationId String @unique
  reservation Reservation @relation(fields: [reservationId], references: [id])
  closedAt DateTime?
  closedById String?
  items FolioItem[]
  payments Payment[]
}

model FolioItem {
  id String @id @default(cuid())
  folioId String
  folio Folio @relation(fields: [folioId], references: [id])
  category String
  description String
  qty Int @default(1)
  unitAmount Int
  businessDate DateTime @db.Date
  postedById String
  voidedAt DateTime?
  voidedById String?
  voidReason String?
  @@index([folioId])
}

model Payment {
  id String @id @default(cuid())
  folioId String
  folio Folio @relation(fields: [folioId], references: [id])
  amount Int
  kind PaymentKind @default(PAYMENT)
  method String
  reference String?
  refundOfId String?
  idempotencyKey String @unique
  receivedById String
  notes String?
  at DateTime @default(now())
  @@index([folioId])
}

model FeeRule {
  id String @id @default(cuid())
  name String
  kind FeeKind
  type FeeType
  value Int
  compound Boolean @default(false)
  active Boolean @default(true)
  sortOrder Int @default(0)
}

model HousekeepingTask {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id])
  status TaskStatus @default(DIRTY)
  assignedToId String?
  notes String?
  startedAt DateTime?
  completedAt DateTime?
  inspectedById String?
  createdAt DateTime @default(now())
  @@index([status])
}

model MaintenanceTicket {
  id String @id @default(cuid())
  roomId String?
  room Room? @relation(fields: [roomId], references: [id])
  area String?
  category String
  description String
  priority String @default("NORMAL")
  status TicketStatus @default(OPEN)
  reportedById String
  assignedToId String?
  resolution String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  userId String
  action String
  entity String
  entityId String
  summary String
  before Json?
  after Json?
  at DateTime @default(now())
  @@index([entity, entityId])
  @@index([at])
}

model Setting {
  key   String @id
  value Json
}
